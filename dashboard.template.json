{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "gco-onboarding-explorer"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {}
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "marcusolsson-dynamictext-panel",
            "version": "6.3.0",
            "spec": {
              "options": {
                "afterRender": "/*@@PAGE@@*/\n\n// Grafana Cloud onboarding explorer — rendered in a same-origin frame so its CSS and ids stay isolated.\nconst host = context.element;\nhost.innerHTML = '';\nconst frame = document.createElement('iframe');\nframe.title = 'Grafana Cloud onboarding explorer';\nframe.setAttribute('allow', 'clipboard-write');\nframe.style.cssText = 'display:block;width:100%;height:900px;border:0;background:transparent';\nconst theme = context.grafana && context.grafana.theme && context.grafana.theme.isDark === false ? 'light' : 'dark';\nframe.srcdoc = HTML;\nhost.appendChild(frame);\n\nframe.addEventListener('load', () => {\n  const win = frame.contentWindow, doc = frame.contentDocument;\n  if (!win || !doc) return;\n  win.GCO_DEFAULT_THEME = theme;\n  try {\n    new win.Function(CODE)();\n  } catch (e) {\n    console.error('[onboarding explorer]', e);\n    doc.body.insertAdjacentHTML('afterbegin', '<p style=\"color:#f55;padding:12px\">Could not start the explorer: ' + String(e && e.message || e).replace(/</g, '&lt;') + '</p>');\n  }\n  // the page sizes this frame to the panel's visible area and scrolls its own columns\n});\n\nreturn () => {\n  frame.remove();\n};\n",
                "content": "<div class=\"gco-host\"></div>",
                "contentPartials": [],
                "defaultContent": "<div class=\"gco-host\"></div>",
                "editor": {
                  "format": "auto",
                  "language": "html"
                },
                "editors": [
                  "afterRender",
                  "styles"
                ],
                "externalStyles": [],
                "helpers": "",
                "renderMode": "data",
                "styles": ".gco-host{width:100%}",
                "wrap": false
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          },
          "transparent": true
        }
      }
    },
    "layout": {
      "kind": "AutoGridLayout",
      "spec": {
        "maxColumnCount": 3,
        "columnWidthMode": "wide",
        "rowHeightMode": "tall",
        "fillScreen": true,
        "items": [
          {
            "kind": "AutoGridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "onboarding"
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": true,
      "fiscalYearStartMonth": 0
    },
    "title": "Grafana Cloud onboarding explorer",
    "variables": [],
    "preferences": {
      "layout": {
        "kind": "GridLayout",
        "spec": {
          "items": []
        }
      }
    }
  }
}
